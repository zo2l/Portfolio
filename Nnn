                            </div>

                            <div class="signal s1"></div>
                            <div class="signal s2"></div>

                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- =====================================================
             ABOUT
        ====================================================== -->

        <section class="section" id="about">

            <div class="container">

                <div class="section-header reveal">

                    <div class="section-kicker">
                        About Me
                    </div>

                    <h2 class="section-title">
                        Networking with a
                        practical mindset.
                    </h2>

                    <p class="section-description">
                        I focus on understanding how systems communicate,
                        how infrastructure is structured, and how to
                        troubleshoot problems efficiently.
                    </p>

                </div>


                <div class="about-grid">

                    <div class="about-card reveal">

                        <h3>
                            Network Specialist
                        </h3>

                        <p>
