                            </div>

                            <div class="meta-item">
                                <span>◆</span>
                                Windows Server
                            </div>

                            <div class="meta-item">
                                <span>◆</span>
                                Troubleshooting
                            </div>

                        </div>

                    </div>


                    <!-- HERO VISUAL -->

                    <div class="hero-visual">

