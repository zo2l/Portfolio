                                        <div>
                                            <strong>YOUR PHOTO</strong>
                                            <br>
                                            Replace:
                                            <br>
                                            IMG/profile.jpg
                                        </div>
                                    </div>

                                </div>

                            </div>

                            <div class="tech-badge b1">
