                </button>

                <button class="nav-btn" id="themeBtn" title="Toggle Theme">
                    ☼
                </button>

                <button
                    class="nav-btn mobile-toggle"
                    id="mobileToggle"
                    title="Menu"
                >
                    ☰
                </button>

            </div>

        </div>

    </header>


    <!-- =========================================================
         HERO
    ========================================================= -->

    <main>

        <section class="hero" id="home">

            <div class="container">

                <div class="hero-grid">

                    <div class="hero-content">

                        <div class="eyebrow">
                            <span class="eyebrow-dot"></span>
                            Network Specialist
                        </div>

                        <h1>
                            Building
