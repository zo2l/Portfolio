<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Abdulrahman Alsahli | Network Specialist</title>
    <meta name="description" content="Abdulrahman Alsahli - Network Specialist specializing in network infrastructure, routing, switching, Windows Server and network troubleshooting.">

    <style>
        /* =========================================================
           ROOT
        ========================================================= */

        :root {
            --bg: #17191a;
            --bg-soft: #1c1f20;
            --surface: #222627;
            --surface-2: #282d2e;

            --text: #eee9df;
            --text-soft: #d1ccc1;
            --muted: #9e9b93;

            --primary: #c8a96b;
            --primary-light: #e1c88f;

            --secondary: #87998b;
            --copper: #a77c5a;

            --line: rgba(238, 233, 223, 0.10);
            --line-strong: rgba(200, 169, 107, 0.28);

            --shadow: 0 25px 80px rgba(0, 0, 0, 0.28);
            --glow: rgba(200, 169, 107, 0.20);

            --radius: 24px;
            --nav-height: 82px;
        }

        body.light {
            --bg: #e4dfd5;
            --bg-soft: #ddd7cc;
            --surface: #eeeae1;
            --surface-2: #f3efe7;

            --text: #252522;
            --text-soft: #45433d;
            --muted: #77736a;

            --line: rgba(37, 37, 34, 0.10);
            --line-strong: rgba(150, 116, 52, 0.30);

            --shadow: 0 25px 70px rgba(62, 55, 43, 0.14);
            --glow: rgba(180, 145, 76, 0.18);
        }


        /* =========================================================
           RESET
        ========================================================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family:
                Inter,
                ui-sans-serif,
                system-ui,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;

            background:
                radial-gradient(
                    circle at 20% 10%,
                    rgba(200, 169, 107, 0.07),
                    transparent 30%
                ),
                radial-gradient(
                    circle at 80% 60%,
                    rgba(135, 153, 139, 0.05),
                    transparent 28%
                ),
                var(--bg);

            color: var(--text);
            overflow-x: hidden;
            transition:
                background 0.4s ease,
                color 0.4s ease;
        }

        body::before {
            content: "";
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 9998;

            background-image:
                linear-gradient(
                    rgba(255,255,255,0.015) 1px,
                    transparent 1px
                ),
                linear-gradient(
                    90deg,
                    rgba(255,255,255,0.015) 1px,
                    transparent 1px
                );

            background-size: 70px 70px;

            mask-image: linear-gradient(
                to bottom,
                black,
                transparent 85%
            );
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        button,
        input,
        textarea {
            font: inherit;
        }

        button {
            border: none;
            background: none;
            color: inherit;
            cursor: pointer;
        }

        img {
            max-width: 100%;
            display: block;
        }

        section {
            position: relative;
            z-index: 2;
        }

        .container {
            width: min(1180px, calc(100% - 40px));
            margin: auto;
        }


        /* =========================================================
           CUSTOM CURSOR
        ========================================================= */

        .cursor-dot,
        .cursor-ring {
            position: fixed;
            top: 0;
            left: 0;

            pointer-events: none;
            z-index: 10000;

            transform: translate(-50%, -50%);
        }

        .cursor-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--primary);
        }

        .cursor-ring {
            width: 34px;
            height: 34px;
            border: 1px solid rgba(200,169,107,0.55);
            border-radius: 50%;

            transition:
                width 0.2s ease,
                height 0.2s ease,
                border-color 0.2s ease;
        }

        body.cursor-hover .cursor-ring {
            width: 55px;
            height: 55px;
            border-color: var(--primary);
        }


        /* =========================================================
           NAVBAR
        ========================================================= */

        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;

            height: var(--nav-height);

            z-index: 999;

            display: flex;
            align-items: center;

            border-bottom: 1px solid transparent;

            transition:
                background 0.35s ease,
                border-color 0.35s ease,
                backdrop-filter 0.35s ease;
        }

        .navbar.scrolled {
            background: rgba(23, 25, 26, 0.78);
            backdrop-filter: blur(20px);
            border-color: var(--line);
        }

        body.light .navbar.scrolled {
            background: rgba(228, 223, 213, 0.80);
        }

        .nav-inner {
            width: min(1180px, calc(100% - 40px));
            margin: auto;

            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 11px;

            font-size: 18px;
            font-weight: 800;
            letter-spacing: -0.5px;
        }

        .logo-mark {
            width: 38px;
            height: 38px;

            display: grid;
            place-items: center;

            border: 1px solid var(--line-strong);
            border-radius: 12px;

            color: var(--primary);

            background:
                linear-gradient(
                    135deg,
                    rgba(200,169,107,0.15),
                    rgba(135,153,139,0.04)
                );

            box-shadow:
                0 0 30px rgba(200,169,107,0.08);
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 30px;
        }

        .nav-links a {
            position: relative;

            color: var(--muted);
            font-size: 14px;
            font-weight: 600;

            transition: color 0.25s ease;
        }

        .nav-links a::after {
            content: "";
            position: absolute;

            left: 0;
            bottom: -8px;

            width: 0;
            height: 1px;

            background: var(--primary);

            transition: width 0.25s ease;
        }

        .nav-links a:hover,
        .nav-links a.active {
            color: var(--text);
        }

        .nav-links a:hover::after,
        .nav-links a.active::after {
            width: 100%;
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .nav-btn {
            width: 40px;
            height: 40px;

            display: grid;
            place-items: center;

            border: 1px solid var(--line);
            border-radius: 12px;

            color: var(--muted);

            transition:
                transform 0.25s ease,
                color 0.25s ease,
                border-color 0.25s ease,
                background 0.25s ease;
        }

        .nav-btn:hover {
            color: var(--primary);
            border-color: var(--line-strong);
            background: rgba(200,169,107,0.05);
            transform: translateY(-2px);
        }

        .mobile-toggle {
            display: none;
        }


        /* =========================================================
           HERO
        ========================================================= */

        .hero {
            min-height: 100vh;
            padding-top: calc(var(--nav-height) + 40px);

            display: flex;
            align-items: center;

            overflow: hidden;
        }

        .hero-grid {
            display: grid;
            grid-template-columns: 1.05fr 0.95fr;
            gap: 60px;
            align-items: center;
        }

        .hero-content {
            position: relative;
            z-index: 5;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 10px;

            padding: 8px 13px;

            border: 1px solid var(--line);
            border-radius: 999px;

            color: var(--muted);
            font-size: 12px;
            font-weight: 700;

            letter-spacing: 1px;
            text-transform: uppercase;

            background: rgba(255,255,255,0.02);

            animation: fadeUp 0.8s ease both;
        }

        .eyebrow-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--secondary);

            box-shadow:
                0 0 0 5px rgba(135,153,139,0.08),
                0 0 18px rgba(135,153,139,0.5);

            animation: pulse 2s infinite;
        }

        .hero h1 {
            margin-top: 25px;

            font-size: clamp(50px, 7vw, 90px);
            line-height: 0.98;

            letter-spacing: -5px;
            font-weight: 850;

            animation: fadeUp 0.9s 0.1s ease both;
        }

        .hero h1 span {
            display: block;

            color: transparent;

            background:
                linear-gradient(
                    100deg,
                    var(--primary-light),
                    var(--primary),
                    var(--copper)
                );

            -webkit-background-clip: text;
            background-clip: text;
        }

        .hero-description {
            max-width: 610px;

            margin-top: 27px;

            color: var(--muted);

            font-size: 17px;
            line-height: 1.9;

            animation: fadeUp 0.9s 0.2s ease both;
        }

        .hero-description strong {
            color: var(--text-soft);
        }

        .hero-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 13px;

            margin-top: 34px;

            animation: fadeUp 0.9s 0.3s ease both;
        }

        .btn {
            position: relative;
            overflow: hidden;

            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;

            min-height: 50px;
            padding: 0 22px;

            border-radius: 14px;

            font-size: 14px;
            font-weight: 750;

            transition:
                transform 0.25s ease,
                border-color 0.25s ease,
                background 0.25s ease;
        }

        .btn-primary {
            color: #191816;

            background:
                linear-gradient(
                    135deg,
                    var(--primary-light),
                    var(--primary)
                );

            box-shadow:
                0 15px 40px rgba(200,169,107,0.12);
        }

        .btn-primary::before {
            content: "";

            position: absolute;
            inset: 0;

            background: linear-gradient(
                100deg,
                transparent,
                rgba(255,255,255,0.35),
                transparent
            );

            transform: translateX(-120%);
            transition: transform 0.6s ease;
        }

        .btn-primary:hover::before {
            transform: translateX(120%);
        }

        .btn-secondary {
            border: 1px solid var(--line);
            background: rgba(255,255,255,0.02);
            color: var(--text-soft);
        }

        .btn-secondary:hover {
            border-color: var(--line-strong);
            background: rgba(200,169,107,0.05);
        }

        .btn:hover {
            transform: translateY(-3px);
        }

        .hero-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 25px;

            margin-top: 42px;

            animation: fadeUp 0.9s 0.4s ease both;
        }

        .meta-item {
            display: flex;
            align-items: center;
            gap: 9px;

            color: var(--muted);
            font-size: 12px;
            font-weight: 650;
        }

        .meta-item span:first-child {
            color: var(--primary);
        }


        /* =========================================================
           HERO VISUAL
        ========================================================= */

        .hero-visual {
            min-height: 590px;

            display: grid;
            place-items: center;

            position: relative;
        }

        .visual-shell {
            position: relative;

            width: min(500px, 90vw);
            aspect-ratio: 1;

            display: grid;
            place-items: center;

            perspective: 1000px;

            animation: visualAppear 1.1s 0.2s ease both;
        }

        .visual-shell::before {
            content: "";

            position: absolute;

            width: 62%;
            height: 62%;

            border-radius: 50%;

            background:
                radial-gradient(
                    circle,
                    rgba(200,169,107,0.17),
                    transparent 65%
                );

            filter: blur(25px);

            animation: breathe 4s ease-in-out infinite;
        }

        .orbit {
            position: absolute;

            border: 1px solid var(--line-strong);

            border-radius: 50%;

            transform: rotateX(65deg) rotateZ(20deg);
        }

        .orbit-1 {
            width: 91%;
            height: 38%;

            animation:
                orbitRotate 12s linear infinite;
        }

        .orbit-2 {
            width: 77%;
            height: 55%;

            transform:
                rotateX(70deg)
                rotateZ(-35deg);

            border-color: rgba(135,153,139,0.28);

            animation:
                orbitRotateReverse 15s linear infinite;
        }

        .orbit-3 {
            width: 62%;
            height: 88%;

            transform:
                rotateX(68deg)
                rotateZ(70deg);

            border-color: rgba(167,124,90,0.25);

            animation:
                orbitRotate 18s linear infinite reverse;
        }

        .profile-frame {
            position: relative;
            z-index: 5;

            width: 55%;
            aspect-ratio: 1;

            padding: 9px;

            border-radius: 50%;

            background:
                conic-gradient(
                    from 0deg,
                    var(--primary),
                    transparent 25%,
                    var(--secondary),
                    transparent 55%,
                    var(--copper),
                    transparent 78%,
                    var(--primary)
                );

            box-shadow:
                0 0 70px rgba(200,169,107,0.12);
        }

        .profile-frame::before {
            content: "";

            position: absolute;
            inset: 7px;

            border-radius: 50%;

            border: 1px solid rgba(255,255,255,0.15);
        }

        .profile-image {
            position: relative;

            width: 100%;
            height: 100%;

            overflow: hidden;

            border-radius: 50%;

            background:
                radial-gradient(
                    circle at 50% 25%,
                    #4a4c4a,
                    #252827 70%
                );

            border: 5px solid var(--bg);
        }

        .profile-image img {
            width: 100%;
            height: 100%;

            object-fit: cover;

            transition: transform 0.7s ease;
        }

        .profile-frame:hover .profile-image img {
            transform: scale(1.06);
        }

        .profile-placeholder {
            width: 100%;
            height: 100%;

            display: grid;
            place-items: center;

            text-align: center;

            color: var(--muted);
            font-size: 11px;
            line-height: 1.8;

            letter-spacing: 1px;
        }

        .profile-placeholder strong {
            color: var(--primary);
            font-size: 15px;
        }

        .orbit-ball {
            position: absolute;

            width: 13px;
            height: 13px;

            border-radius: 50%;

            z-index: 8;

            box-shadow:
                0 0 0 5px rgba(200,169,107,0.06),
                0 0 25px rgba(200,169,107,0.45);
        }

        .ball-1 {
            background: var(--primary);
            animation: ball1 7s linear infinite;
        }

        .ball-2 {
            background: var(--secondary);
            animation: ball2 9s linear infinite;
        }

        .ball-3 {
            background: var(--copper);
            animation: ball3 11s linear infinite;
        }

        .ball-4 {
            background: var(--primary-light);
            animation: ball4 13s linear infinite;
        }

        .tech-badge {
            position: absolute;

            z-index: 10;

            padding: 9px 13px;

            border: 1px solid var(--line-strong);
            border-radius: 12px;

            background:
                rgba(23,25,26,0.72);

            backdrop-filter: blur(12px);

            color: var(--text-soft);

            font-size: 10px;
            font-weight: 800;

            letter-spacing: 0.7px;

            box-shadow:
                0 15px 35px rgba(0,0,0,0.18);
        }

        body.light .tech-badge {
            background: rgba(238,234,225,0.76);
        }

        .b1 {
            top: 19%;
            left: 3%;
            animation: floatA 4.5s ease-in-out infinite;
        }

        .b2 {
            top: 8%;
            right: 10%;
            animation: floatB 5s 0.5s ease-in-out infinite;
        }

        .b3 {
            right: 0;
            bottom: 24%;
            animation: floatA 4.8s 0.7s ease-in-out infinite;
        }

        .b4 {
            left: 6%;
            bottom: 17%;
            animation: floatB 5.2s 0.2s ease-in-out infinite;
        }

        .signal {
            position: absolute;

            height: 1px;

            background:
                linear-gradient(
                    90deg,
                    transparent,
                    var(--primary),
                    transparent
                );

            opacity: 0.4;
        }

        .signal.s1 {
            width: 170px;
            top: 30%;
            right: -5%;

            animation: signalMove 3s ease-in-out infinite;
        }

        .signal.s2 {
            width: 130px;
            bottom: 32%;
            left: -5%;

            animation: signalMove 3.5s 1s ease-in-out infinite reverse;
        }


        /* =========================================================
           SECTION HEADERS
        ========================================================= */

        .section {
            padding: 120px 0;
        }

        .section-header {
            max-width: 720px;
            margin-bottom: 50px;
        }

        .section-kicker {
            color: var(--primary);
            font-size: 11px;
            font-weight: 850;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 14px;
        }

        .section-title {
            font-size: clamp(34px, 5vw, 56px);
            line-height: 1.05;
            letter-spacing: -2.5px;
        }

        .section-description {
            margin-top: 17px;

            color: var(--muted);

            line-height: 1.8;
            font-size: 15px;
        }


        /* =========================================================
           ABOUT
        ========================================================= */

        .about-grid {
            display: grid;
            grid-template-columns: 0.9fr 1.1fr;
            gap: 25px;
        }

        .about-card {
            position: relative;

            padding: 34px;

            border: 1px solid var(--line);
            border-radius: var(--radius);

            background:
                linear-gradient(
                    145deg,
                    rgba(255,255,255,0.035),
                    rgba(255,255,255,0.008)
                );

            box-shadow: var(--shadow);

            overflow: hidden;
        }

        .about-card::before {
            content: "";

            position: absolute;

            width: 180px;
            height: 180px;

            right: -80px;
            top: -80px;

            border-radius: 50%;

            background:
                radial-gradient(
                    circle,
                    rgba(200,169,107,0.13),
                    transparent 70%
                );
        }

        .about-card h3 {
            font-size: 21px;
            margin-bottom: 16px;
        }

        .about-card p {
            color: var(--muted);
            line-height: 1.9;
            font-size: 14px;
        }

        .about-list {
            display: grid;
            gap: 14px;
        }

        .about-list-item {
            display: flex;
            align-items: flex-start;
            gap: 13px;

            padding: 16px;

            border: 1px solid var(--line);
            border-radius: 15px;

            background: rgba(255,255,255,0.015);
        }

        .about-list-icon {
            width: 32px;
            height: 32px;

            flex: 0 0 32px;

            display: grid;
            place-items: center;

            border-radius: 10px;

            color: var(--primary);

            background: rgba(200,169,107,0.08);
        }

        .about-list-item strong {
            display: block;
            font-size: 13px;
            margin-bottom: 4px;
        }

        .about-list-item span {
            color: var(--muted);
            font-size: 12px;
            line-height: 1.6;
        }


        /* =========================================================
           EXPERTISE
        ========================================================= */

        .expertise-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;
        }

        .expertise-card {
            position: relative;

            min-height: 270px;
            padding: 28px;

            border: 1px solid var(--line);
            border-radius: var(--radius);

            background:
                linear-gradient(
                    145deg,
                    rgba(255,255,255,0.035),
                    transparent
                );

            overflow: hidden;

            transition:
                transform 0.35s ease,
                border-color 0.35s ease,
                background 0.35s ease;
        }

        .expertise-card:hover {
            transform: translateY(-9px);
            border-color: var(--line-strong);

            background:
                linear-gradient(
                    145deg,
                    rgba(200,169,107,0.07),
                    rgba(255,255,255,0.015)
                );
        }

        .expertise-number {
            position: absolute;

            right: 22px;
            top: 17px;

            color: rgba(255,255,255,0.05);

            font-size: 60px;
            font-weight: 900;
        }

        .expertise-icon {
            width: 50px;
            height: 50px;

            display: grid;
            place-items: center;

            border: 1px solid var(--line-strong);
            border-radius: 15px;

            color: var(--primary);

            background: rgba(200,169,107,0.07);

            font-size: 20px;

            margin-bottom: 23px;
        }

        .expertise-card h3 {
            font-size: 18px;
            margin-bottom: 12px;
        }

        .expertise-card p {
            color: var(--muted);
            font-size: 13px;
            line-height: 1.8;
        }


        /* =========================================================
           SKILLS
        ========================================================= */

        .skills-layout {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
        }

        .skills-panel {
            padding: 30px;

            border: 1px solid var(--line);
            border-radius: var(--radius);

            background: rgba(255,255,255,0.018);
        }

        .skill {
            margin-bottom: 23px;
        }

        .skill:last-child {
            margin-bottom: 0;
        }

        .skill-top {
            display: flex;
            justify-content: space-between;

            margin-bottom: 9px;

            font-size: 12px;
            font-weight: 700;
        }

        .skill-top span:last-child {
            color: var(--primary);
        }

        .skill-bar {
            height: 6px;

            overflow: hidden;

            border-radius: 99px;

            background: rgba(255,255,255,0.06);
        }

        .skill-fill {
            width: 0;
            height: 100%;

            border-radius: inherit;

            background:
                linear-gradient(
                    90deg,
                    var(--primary),
                    var(--primary-light)
                );

            transition: width 1.3s cubic-bezier(.2,.8,.2,1);
        }

        .tag-cloud {
            display: flex;
            flex-wrap: wrap;
            gap: 9px;
        }

        .tag {
            padding: 10px 13px;

            border: 1px solid var(--line);
            border-radius: 11px;

            color: var(--text-soft);

            font-size: 11px;
            font-weight: 700;

            background: rgba(255,255,255,0.018);

            transition:
                transform 0.25s ease,
                border-color 0.25s ease,
                color 0.25s ease;
        }

        .tag:hover {
            transform: translateY(-3px);
            color: var(--primary-light);
            border-color: var(--line-strong);
        }


        /* =========================================================
           PROJECTS
        ========================================================= */

        .projects-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 22px;
        }

        .project-card {
            position: relative;

            overflow: hidden;

            border: 1px solid var(--line);
            border-radius: var(--radius);

            background: var(--surface);

            transition:
                transform 0.4s ease,
                border-color 0.4s ease;
        }

        .project-card:hover {
            transform: translateY(-8px);
            border-color: var(--line-strong);
        }

        .project-image {
            position: relative;

            height: 260px;

            overflow: hidden;

            background:
                linear-gradient(
                    135deg,
                    #252a29,
                    #151817
                );
        }

        .project-image img {
            width: 100%;
            height: 100%;

            object-fit: cover;

            opacity: 0.75;

            transition:
                transform 0.7s ease,
                opacity 0.7s ease;
        }

        .project-card:hover .project-image img {
            transform: scale(1.06);
            opacity: 0.9;
        }

        .project-overlay {
            position: absolute;
            inset: 0;

            display: flex;
            align-items: flex-end;

            padding: 22px;

            background:
                linear-gradient(
                    to top,
                    rgba(10,11,11,0.8),
                    transparent 65%
                );
        }

        .project-placeholder {
            position: absolute;
            inset: 0;

            display: grid;
            place-items: center;

            text-align: center;

            color: var(--muted);

            font-size: 12px;
            line-height: 1.8;
        }

        .project-placeholder strong {
            display: block;

            color: var(--primary);

            font-size: 18px;
            margin-bottom: 4px;
        }

        .project-body {
            padding: 24px;
        }

        .project-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;

            margin-bottom: 13px;
        }

        .project-tag {
            padding: 6px 9px;

            border-radius: 8px;

            color: var(--primary-light);

            background: rgba(200,169,107,0.07);

            font-size: 9px;
            font-weight: 800;
        }

        .project-body h3 {
            font-size: 20px;
            margin-bottom: 9px;
        }

        .project-body p {
            color: var(--muted);

            font-size: 13px;
            line-height: 1.8;
        }

        .project-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;

            margin-top: 18px;

            color: var(--primary);

            font-size: 12px;
            font-weight: 800;
        }


        /* =========================================================
           DEVELOPMENT
        ========================================================= */

        .development {
            padding-top: 50px;
        }

        .dev-box {
            position: relative;

            min-height: 390px;

            display: grid;
            place-items: center;

            overflow: hidden;

            border: 1px solid var(--line);
            border-radius: 32px;

            background:
                radial-gradient(
                    circle at center,
                    rgba(200,169,107,0.07),
                    transparent 38%
                ),
                var(--surface);

            box-shadow: var(--shadow);
        }

        .dev-orbit {
            position: absolute;

            width: 330px;
            height: 160px;

            border: 1px solid var(--line-strong);

            border-radius: 50%;

            transform: rotateX(65deg);

            animation: devOrbit 10s linear infinite;
        }

        .dev-orbit:nth-child(2) {
            width: 250px;
            height: 260px;

            transform:
                rotateX(65deg)
                rotateZ(65deg);

            animation-duration: 13s;
        }

        .dev-orbit:nth-child(3) {
            width: 180px;
            height: 330px;

            transform:
                rotateX(65deg)
                rotateZ(-50deg);

            animation-duration: 16s;
        }

        .dev-core {
            position: relative;
            z-index: 5;

            width: 130px;
            height: 130px;

            display: grid;
            place-items: center;

            border-radius: 50%;

            border: 1px solid var(--line-strong);

            color: var(--primary-light);

            background:
                radial-gradient(
                    circle,
                    rgba(200,169,107,0.17),
                    rgba(34,38,39,0.95)
                );

            box-shadow:
                0 0 60px rgba(200,169,107,0.12);

            text-align: center;
        }

        .dev-core strong {
            font-size: 15px;
        }

        .dev-core span {
            display: block;

            margin-top: 5px;

            color: var(--muted);
            font-size: 9px;
        }

        .dev-chip {
            position: absolute;

            padding: 10px 13px;

            border: 1px solid var(--line);
            border-radius: 11px;

            background: rgba(23,25,26,0.7);

            color: var(--text-soft);

            font-size: 10px;
            font-weight: 800;
        }

        .dev-chip.c1 {
            top: 22%;
            left: 17%;
        }

        .dev-chip.c2 {
            top: 20%;
            right: 18%;
        }

        .dev-chip.c3 {
            bottom: 20%;
            left: 20%;
        }

        .dev-chip.c4 {
            bottom: 19%;
            right: 20%;
        }


        /* =========================================================
           CONTACT
        ========================================================= */

        .contact-grid {
            display: grid;
            grid-template-columns: 0.8fr 1.2fr;
            gap: 25px;
        }

        .contact-info,
        .contact-form {
            padding: 32px;

            border: 1px solid var(--line);
            border-radius: var(--radius);

            background:
                linear-gradient(
                    145deg,
                    rgba(255,255,255,0.03),
                    rgba(255,255,255,0.008)
                );
        }

        .contact-info h3 {
            font-size: 24px;
            margin-bottom: 13px;
        }

        .contact-info > p {
            color: var(--muted);

            font-size: 13px;
            line-height: 1.8;

            margin-bottom: 28px;
        }

        .contact-item {
            display: flex;
            gap: 13px;

            padding: 15px 0;

            border-bottom: 1px solid var(--line);
        }

        .contact-item:last-child {
            border-bottom: none;
        }

        .contact-icon {
            width: 38px;
            height: 38px;

            flex: 0 0 38px;

            display: grid;
            place-items: center;

            border-radius: 11px;

            background: rgba(200,169,107,0.08);

            color: var(--primary);
        }

        .contact-item small {
            display: block;

            color: var(--muted);

            font-size: 10px;
            margin-bottom: 4px;
        }

        .contact-item strong {
            font-size: 12px;
            word-break: break-word;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 13px;
        }

        .field {
            margin-bottom: 14px;
        }

        .field label {
            display: block;

            margin-bottom: 7px;

            color: var(--text-soft);

            font-size: 11px;
            font-weight: 700;
        }

        .field input,
        .field textarea {
            width: 100%;

            border: 1px solid var(--line);
            border-radius: 13px;

            padding: 13px 14px;

            outline: none;

            background: rgba(255,255,255,0.018);

            color: var(--text);

            transition:
                border-color 0.25s ease,
                box-shadow 0.25s ease;
        }

        .field textarea {
            min-height: 150px;
            resize: vertical;
        }

        .field input:focus,
        .field textarea:focus {
            border-color: var(--line-strong);

            box-shadow:
                0 0 0 4px rgba(200,169,107,0.05);
        }


        /* =========================================================
           RESUME
        ========================================================= */

        .resume-section {
            padding-top: 20px;
            padding-bottom: 100px;
        }

        .resume-box {
            position: relative;
            padding: 55px 40px;
            text-align: center;
            border: 1px solid var(--line);
            border-radius: 32px;
            background:
                radial-gradient(
                    circle at center,
                    rgba(200,169,107,0.08),
                    transparent 55%
                ),
                var(--surface);
            box-shadow: var(--shadow);
            overflow: hidden;
        }

        .resume-box .section-description {
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }

        .resume-button-wrap {
            display: flex;
            justify-content: center;
            margin-top: 28px;
        }

        .resume-button-wrap .btn {
            min-width: 190px;
        }


        /* =========================================================
           FOOTER
        ========================================================= */

        footer {
            position: relative;
            z-index: 2;

            padding: 30px 0 40px;

            border-top: 1px solid var(--line);
        }

        .footer-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        .footer-inner p {
            color: var(--muted);
            font-size: 11px;
        }

        .footer-mark {
            color: var(--primary);
            font-size: 12px;
            font-weight: 850;
        }


        /* =========================================================
           LIGHTBOX
        ========================================================= */

        .lightbox {
            position: fixed;
            inset: 0;

            z-index: 10001;

            display: none;
            place-items: center;

            padding: 30px;

            background: rgba(10,11,11,0.88);

            backdrop-filter: blur(16px);
        }

        .lightbox.active {
            display: grid;
        }

        .lightbox img {
            max-width: min(1000px, 92vw);
            max-height: 82vh;

            border-radius: 18px;

            border: 1px solid var(--line-strong);

            box-shadow:
                0 40px 100px rgba(0,0,0,0.5);
        }

        .lightbox-close {
            position: absolute;

            top: 25px;
            right: 25px;

            width: 46px;
            height: 46px;

            display: grid;
            place-items: center;

            border: 1px solid var(--line);
            border-radius: 13px;

            background: rgba(255,255,255,0.04);

            font-size: 25px;

            color: var(--text);
        }


        /* =========================================================
           AMBIENT GLOW
        ========================================================= */

        .mouse-glow {
            position: fixed;

            width: 420px;
            height: 420px;

            pointer-events: none;
            z-index: 0;

            border-radius: 50%;

            background:
                radial-gradient(
                    circle,
                    var(--glow),
                    transparent 68%
                );

            transform: translate(-50%, -50%);

            filter: blur(10px);

            opacity: 0.65;
        }

        .particles {
            position: fixed;
            inset: 0;

            pointer-events: none;
            z-index: 1;

            overflow: hidden;
        }

        .particle {
            position: absolute;

            width: 2px;
            height: 2px;

            border-radius: 50%;

            background: var(--primary);

            opacity: 0.25;

            animation:
                particleFloat linear infinite;
        }


        /* =========================================================
           SCROLL REVEAL
        ========================================================= */

        .reveal {
            opacity: 0;
            transform: translateY(35px);

            transition:
                opacity 0.8s ease,
                transform 0.8s ease;
        }

        .reveal.visible {
            opacity: 1;
            transform: translateY(0);
        }


        /* =========================================================
           ANIMATIONS
        ========================================================= */

        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(25px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes visualAppear {
            from {
                opacity: 0;
                transform: scale(0.85) rotateY(12deg);
            }

            to {
                opacity: 1;
                transform: scale(1) rotateY(0);
            }
        }

        @keyframes pulse {
            0%, 100% {
                transform: scale(1);
                opacity: 0.8;
            }

            50% {
                transform: scale(1.3);
                opacity: 1;
            }
        }

        @keyframes breathe {
            0%, 100% {
                transform: scale(0.9);
                opacity: 0.65;
            }

            50% {
                transform: scale(1.12);
                opacity: 1;
            }
        }

        @keyframes frameRotate {
            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }

        @keyframes orbitRotate {
            from {
                transform:
                    rotateX(65deg)
                    rotateZ(0deg);
            }

            to {
                transform:
                    rotateX(65deg)
                    rotateZ(360deg);
            }
        }

        @keyframes orbitRotateReverse {
            from {
                transform:
                    rotateX(70deg)
                    rotateZ(360deg);
            }

            to {
                transform:
                    rotateX(70deg)
                    rotateZ(0deg);
            }
        }

        @keyframes ball1 {
            from {
                transform:
                    rotate(0deg)
                    translateX(225px)
                    rotate(0deg);
            }

            to {
                transform:
                    rotate(360deg)
                    translateX(225px)
                    rotate(-360deg);
            }
        }

        @keyframes ball2 {
            from {
                transform:
                    rotate(360deg)
                    translateX(185px)
                    rotate(-360deg);
            }

            to {
                transform:
                    rotate(0deg)
                    translateX(185px)
                    rotate(0deg);
            }
        }

        @keyframes ball3 {
            from {
                transform:
                    rotate(0deg)
                    translateX(150px)
                    rotate(0deg);
            }

            to {
                transform:
                    rotate(360deg)
                    translateX(150px)
                    rotate(-360deg);
            }
        }

        @keyframes ball4 {
            from {
                transform:
                    rotate(360deg)
                    translateX(205px)
                    rotate(-360deg);
            }

            to {
                transform:
                    rotate(0deg)
                    translateX(205px)
                    rotate(0deg);
            }
        }

        @keyframes floatA {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-12px);
            }
        }

        @keyframes floatB {
            0%, 100% {
                transform: translateY(0) rotate(0deg);
            }

            50% {
                transform: translateY(10px) rotate(2deg);
            }
        }

        @keyframes signalMove {
            0%, 100% {
                opacity: 0.1;
                transform: scaleX(0.7);
            }

            50% {
                opacity: 0.65;
                transform: scaleX(1.2);
            }
        }

        @keyframes devOrbit {
            from {
                transform:
                    rotateX(65deg)
                    rotateZ(0deg);
            }

            to {
                transform:
                    rotateX(65deg)
                    rotateZ(360deg);
            }
        }

        @keyframes particleFloat {
            from {
                transform:
                    translateY(110vh)
                    translateX(0);
            }

            to {
                transform:
                    translateY(-10vh)
                    translateX(60px);
            }
        }


        /* =========================================================
           RESPONSIVE
        ========================================================= */

        @media (max-width: 950px) {

            .hero-grid {
                grid-template-columns: 1fr;
                gap: 30px;
            }

            .hero-content {
                text-align: center;
            }

            .hero-description {
                margin-left: auto;
                margin-right: auto;
            }

            .hero-buttons,
            .hero-meta {
                justify-content: center;
            }

            .hero-visual {
                min-height: 500px;
            }

            .about-grid,
            .skills-layout,
            .contact-grid {
                grid-template-columns: 1fr;
            }

            .expertise-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }


        @media (max-width: 760px) {

            :root {
                --nav-height: 72px;
            }

            .container,
            .nav-inner {
                width: min(100% - 28px, 1180px);
            }

            .nav-links {
                position: fixed;

                top: var(--nav-height);
                left: 14px;
                right: 14px;

                padding: 18px;

                display: none;
                flex-direction: column;
                align-items: stretch;

                border: 1px solid var(--line);
                border-radius: 18px;

                background: rgba(23,25,26,0.96);

                backdrop-filter: blur(20px);

                box-shadow: var(--shadow);
            }

            body.light .nav-links {
                background: rgba(238,234,225,0.97);
            }

            .nav-links.open {
                display: flex;
            }

            .nav-links a {
                padding: 12px;
            }

            .mobile-toggle {
                display: grid;
            }

            .hero {
                padding-top: 110px;
            }

            .hero h1 {
                font-size: clamp(44px, 14vw, 72px);
                letter-spacing: -3px;
            }

            .hero-description {
                font-size: 15px;
            }

            .hero-visual {
                min-height: 400px;
            }

            .visual-shell {
                width: 390px;
                max-width: 100%;
            }

            .profile-frame {
                width: 52%;
            }

            .tech-badge {
                font-size: 8px;
                padding: 7px 9px;
            }

            .b1 {
                left: 0;
            }

            .b2 {
                right: 0;
            }

            .b3 {
                right: 0;
            }

            .b4 {
                left: 0;
            }

            .section {
                padding: 85px 0;
            }

            .section-title {
                font-size: 38px;
            }

            .expertise-grid,
            .projects-grid {
                grid-template-columns: 1fr;
            }

            .project-image {
                height: 220px;
            }

            .form-row {
                grid-template-columns: 1fr;
            }

            .footer-inner {
                flex-direction: column;
                text-align: center;
            }

            .cursor-dot,
            .cursor-ring {
                display: none;
            }
        }

        @media (max-width: 430px) {

            .hero-buttons {
                flex-direction: column;
            }

            .hero-buttons .btn {
                width: 100%;
            }

            .hero-meta {
                gap: 15px;
            }

            .hero-visual {
                min-height: 350px;
            }

            .visual-shell {
                transform: scale(0.88);
            }

            .about-card,
            .skills-panel,
            .contact-info,
            .contact-form {
                padding: 23px;
            }
        }


        /* =========================================================
           REDUCED MOTION
        ========================================================= */

        @media (prefers-reduced-motion: reduce) {

            *,
            *::before,
            *::after {
                animation-duration: 0.001ms !important;
                animation-iteration-count: 1 !important;
                scroll-behavior: auto !important;
                transition-duration: 0.001ms !important;
            }
        }
    </style>
</head>


<body>

    <!-- =========================================================
         AMBIENT EFFECTS
